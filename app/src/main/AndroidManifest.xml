<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- DER ANRUF GEHÖRT DEM SYSTEM (Etappe 1, docs/AUFTRAG-AUTO.md).
         Ohne MANAGE_OWN_CALLS nimmt Telecom keinen selbstverwalteten
         Anruf entgegen – und damit ist die App im Auto unsichtbar.
         Die Berechtigung ist nicht gefährlich und wird nicht erfragt. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Video: Die Kamera wird NUR gebraucht, wenn jemand im Gespräch auf
         „Video" drückt. Sie ist deshalb als NICHT erforderlich vermerkt –
         ein Gerät ohne Kamera soll die App trotzdem installieren können. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Seit Android 14 braucht JEDER Typ eines Vordergrunddienstes seine
         eigene Erlaubnis. Der Dienst hält nicht nur die Registrierung, er
         trägt auch den Ton des Gesprächs – ohne diese Zeile wirft Android
         beim Start, und zwar erst am Gerät. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- KEINE SICHERUNG DURCH GOOGLE, und das ist die wichtigste Zeile
         dieser Datei.

         Androids Vorgabe für allowBackup ist WAHR. Damit wandert der
         private Anwendungsspeicher in Googles Sicherung – und darin
         liegt seit Stufe 3 der Verschlüsselung der PRIVATE Schlüssel
         des Ende-zu-Ende-Chats. Die Zusage lautet „er verlässt das
         Gerät nie"; mit einer Sicherung wäre sie unwahr, und der
         Nächste, der die App auf einem neuen Telefon wiederherstellt,
         läse die Post des Vorigen.

         usesCleartextTraffic=false ist Plays automatische Prüfung: Ein
         Klartext-HTTP im Netz weist der Store ab. Diese App braucht
         keines – der Dienst der Anlage besteht auf TLS.

         Die drei Zeilen zur Sicherung stehen zusammen, weil Android sie
         je nach Fassung unterschiedlich liest: allowBackup bis 11,
         fullBackupContent bis 11, dataExtractionRules ab 12. -->
    <application
        android:name=".SoftphoneApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.DariaTech"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/keine_datenentnahme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ein Gespräch im Chat. Eine Activity, die hier fehlt,
             stürzt beim Öffnen ab (ActivityNotFoundException) – und
             zwar erst am Gerät, nicht beim Übersetzen. -->
        <activity
            android:name=".GespraechsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Hält die SIP-Registrierung im Hintergrund (Liblinphone-Dienst) -->
        <service
            android:name="org.linphone.core.tools.service.CoreService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone"
            android:stopWithTask="false" />
    </application>
</manifest>
