<?xml version="1.0" encoding="utf-8"?>
<!--
  DAS PROFIL EINES MENSCHEN – als Blatt von unten.

  DER AUFTRAG (Inhaber, 09.09.2026): „alles was in Portal eingetragen
  wird pro User soll in der App im Profil angezeigt werden, im eigenen
  Profil als auch im Profil anderer Kollegen der Organisation." Als
  Vorbild hat er WhatsApp und Teams genannt; dort ist das Profil ein
  Blatt, das von unten kommt, und nicht ein eigener Bildschirm. Der
  Grund ist derselbe wie dort: Man will kurz nachsehen, wer das ist,
  und dann weitermachen.

  OBEN DER MENSCH, UNTEN SEINE ANGABEN, DAZWISCHEN DIE ZWEI KNÖPFE.
  Anrufen und Nachricht stehen VOR den Angaben – wer ein Profil
  öffnet, will meistens eines von beidem.

  Die Zeilen der Angaben sind ALLE gleich gebaut (Beschriftung klein
  darüber, Wert darunter) und werden ausgeblendet, wenn nichts
  gepflegt ist. Eine Zeile „Abteilung: –" sagt nichts und kostet
  Platz.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal">

            <TextView
                android:id="@+id/profilKuerzel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/kreis_flaeche"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="30sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/profilFoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/foto_des_anrufers"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/profilName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profilRolle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp" />

        <!-- AUSSER DIENST steht als eigener Streifen da, nicht als
             Nebensatz: Wer das übersieht, ruft dreimal an. -->
        <TextView
            android:id="@+id/profilAusserDienst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/kreis_flaeche"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/profil_ausser_dienst"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/profilKnoepfe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profilAnrufen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/profil_anrufen"
                app:icon="@drawable/ic_anrufe" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profilNachricht"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/profil_nachricht" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profilAngaben"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/profilLeer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
