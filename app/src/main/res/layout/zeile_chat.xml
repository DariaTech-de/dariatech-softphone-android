<?xml version="1.0" encoding="utf-8"?>
<!--
  EINE ZEILE IM CHAT: ein Mensch des Hauses.

  Derselbe Aufbau wie im Adressbuch (zeile_kontakt.xml) – Kreis links,
  Name, Zeile darunter. Zwei Listen, die sich verschieden anfühlen, sind
  zwei Apps.

  DIE ZWEITE ZEILE IST DIE LETZTE NACHRICHT. Ohne sie muss man jedes
  Gespräch öffnen, um zu sehen, ob etwas Neues darin steht – und genau
  dafür ist eine Liste da.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp">

        <TextView
            android:id="@+id/chatKuerzel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/kreis_flaeche"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/zeileChatBild"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chatName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/chatVorschau"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/chatZeit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />
</LinearLayout>
