<?xml version="1.0" encoding="utf-8"?>
<!--
  DER BEREICH „KONTAKTE".

  Die Liste und der leere Zustand liegen ÜBEREINANDER, nicht
  nebeneinander: Sichtbar ist immer genau eines. Ein Bereich, in dem
  beides untereinander steht, springt beim ersten Laden.

  Der leere Zustand sagt, was fehlt, statt eine leere Fläche zu zeigen –
  „nichts da" und „kaputt" sehen sonst gleich aus.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- DAS SUCHFELD (09.09.2026). Der Auftrag des Inhabers nannte den
         Zweck: „vorallem um in Apps nach der mitarbeiter zu suchen und
         anzuchaten wie bei Whatsapp oder Teams." Gesucht wird über
         Name, Position, Abteilung, Durchwahl, Rufnummer und E-Mail –
         nicht nur über den Namen, denn genau den kennt man ja oft
         nicht mehr. -->
    <EditText
        android:id="@+id/kontakteSuche"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/eingabe_feld"
        android:hint="@string/kontakte_suchen"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        android:visibility="gone"
        android:autofillHints="" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/kontakteListe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/kontakteLeer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/kontakteLeerZeichen"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:alpha="0.35"
            android:contentDescription="@null"
            android:src="@drawable/ic_kontakte" />

        <TextView
            android:id="@+id/kontakteLeerTitel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kontakteLeerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />
    </LinearLayout>
    </FrameLayout>
</LinearLayout>
