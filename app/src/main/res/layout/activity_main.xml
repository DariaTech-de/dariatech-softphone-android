<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- ==================== Hauptbildschirm ==================== -->
    <LinearLayout
        android:id="@+id/mainScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Kopfzeile mit Registrierungs-Status -->
        <!-- ==================== Markenleiste ====================
             Sie bleibt in beiden Modi dunkelgrün – wie die Kopfzeile im
             Portal der Anlage. Das ist unsere Klammer über Portal,
             Desktop, Android und iOS (docs/GESTALTUNG-MOBIL.md im
             Repository dariatech-pbx) und gleichzeitig der sichtbarste
             Unterschied zu jeder anderen Telefon-App. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/marke"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <!-- Das Profilbild führt zu den Einstellungen. Sie stehen
                 nicht in der Leiste unten: Man öffnet sie einmal beim
                 Einrichten und danach selten. -->
            <FrameLayout
                android:id="@+id/profilKnopf"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/profil_oeffnen"
                android:focusable="true">

                <TextView
                    android:id="@+id/profilKuerzel"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="@drawable/kreis_marke"
                    android:gravity="center"
                    android:textColor="@color/auf_marke"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/dot_red" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/auf_marke"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:text="@string/not_connected"
                    android:textColor="@color/auf_marke"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Inhalt: Wähltastatur / Verlauf / Einstellungen -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Wähltastatur -->
            <LinearLayout
                android:id="@+id/viewDialpad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/number"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center"
                        android:hint="@string/number_hint"
                        android:importantForAutofill="no"
                        android:inputType="phone"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/backspaceButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="⌫"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/keypadGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:columnCount="3" />

                <Button
                    android:id="@+id/callButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:text="@string/call"
                    android:textSize="17sp" />
            </LinearLayout>

            <!-- Anrufliste -->
            <LinearLayout
                android:id="@+id/viewHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/missedInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="12dp" />

                <TextView
                    android:id="@+id/historyEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/history_empty"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Einstellungen (SIP-Konto) -->
            <ScrollView
                android:id="@+id/viewSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_section"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/preset_hint_label"
                        android:textSize="13sp" />

                    <AutoCompleteTextView
                        android:id="@+id/preset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:hint="@string/preset_hint_label" />

                    <TextView
                        android:id="@+id/presetHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/domain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/domain_hint"
                        android:importantForAutofill="no"
                        android:inputType="textUri" />

                    <EditText
                        android:id="@+id/username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/username_hint"
                        android:importantForAutofill="no"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/password_hint"
                        android:importantForAutofill="no"
                        android:inputType="textPassword" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/transport_hint"
                        android:textSize="13sp" />

                    <AutoCompleteTextView
                        android:id="@+id/transport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />

                    <Button
                        android:id="@+id/connectButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:backgroundTint="?attr/colorPrimary"
                        android:text="@string/save_connect" />
                </LinearLayout>
            </ScrollView>
            <!-- Kontakte und Nachrichten. Beide holen ihre Daten noch
                 nicht von der Anlage; bis dahin sagen sie das, statt auf
                 einen anderen Bereich umzuleiten. Eine App, die auf
                 „Kontakte" den Verlauf zeigt, ist kaputt – eine, die
                 sagt „kommt aus dem Portal", ist ehrlich. -->
            <include
                android:id="@+id/viewKontakte"
                layout="@layout/view_leer"
                android:visibility="gone" />

            <include
                android:id="@+id/viewNachrichten"
                layout="@layout/view_leer"
                android:visibility="gone" />
        </FrameLayout>

        <!-- ==================== Leiste am unteren Rand ====================
             Vier Punkte, weil vier die Grenze ist, ab der man nicht mehr
             blind trifft. Material 3 bringt die Hervorhebung des aktiven
             Punktes selbst mit – in UNSEREM Grün, nicht in einem Blau
             (siehe pruefstuecke/gestaltung.mjs, Abschnitt 5). -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/leiste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/leiste" />
    </LinearLayout>

    <!-- ==================== Anruf-Vollbild ==================== -->
    <LinearLayout
        android:id="@+id/callOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gespraech_grund"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bild.
             Die große Fläche zeigt die Gegenstelle, die kleine das eigene
             Vorschaubild. Beide sind ausgeblendet, solange kein Video
             läuft: Ein schwarzes Rechteck in einem Telefonat ohne Bild
             sieht aus wie ein Fehler. -->
        <FrameLayout
            android:id="@+id/videoBereich"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:visibility="gone">

            <TextureView
                android:id="@+id/videoFremd"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextureView
                android:id="@+id/videoEigen"
                android:layout_width="96dp"
                android:layout_height="128dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/callerInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorSurface"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/callState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOutline"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/callDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorSurface"
            android:textSize="17sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- DTMF-Tastenfeld (im Gespräch einblendbar) -->
        <GridLayout
            android:id="@+id/dtmfPad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:visibility="gone" />

        <!-- Steuerung im Gespräch -->
        <LinearLayout
            android:id="@+id/activeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/muteButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/mute" />

            <Button
                android:id="@+id/speakerButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/speaker" />

            <Button
                android:id="@+id/holdButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/hold" />

            <Button
                android:id="@+id/dtmfButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/dtmf" />
        </LinearLayout>

        <!-- Video-Steuerung: eigene Zeile, damit die gewohnten vier
             Knöpfe oben stehen bleiben, wo die Finger sie suchen. -->
        <LinearLayout
            android:id="@+id/videoControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/videoButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/video_start" />

            <Button
                android:id="@+id/kameraButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/camera_switch"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Eingehender Anruf -->
        <LinearLayout
            android:id="@+id/incomingControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/answerButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorPrimary"
                android:text="@string/answer" />

            <Button
                android:id="@+id/declineButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_margin="6dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorError"
                android:text="@string/decline" />
        </LinearLayout>

        <Button
            android:id="@+id/hangupButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="?attr/colorError"
            android:text="@string/hangup" />
    </LinearLayout>
</FrameLayout>
