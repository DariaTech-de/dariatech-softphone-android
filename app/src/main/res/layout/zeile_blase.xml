<?xml version="1.0" encoding="utf-8"?>
<!--
  EINE NACHRICHT IM GESPRÄCH.

  Die eigene rechts und in der Markenfarbe, die fremde links und grau.
  Das ist keine Mode, sondern die einzige Art, einen Verlauf im
  Vorbeigehen zu lesen. Ausgerichtet wird im Adapter (blaseRahmen), weil
  die Richtung erst dort feststeht.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blaseRahmen"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/blase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/blaseText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/blaseZeit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
