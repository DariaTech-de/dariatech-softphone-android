<?xml version="1.0" encoding="utf-8"?>
<!--
  Das dunkle Thema. Es belegt DIESELBEN Rollen wie das helle – die
  Farbwerte kommen aus values-night/colors.xml.

  Ohne diese Datei gälten nachts die hellen Farbrollen von Material,
  und die App sähe halb umgestellt aus: dunkle Flächen, helle Knöpfe.
-->
<resources>
    <style name="Theme.DariaTech" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primaer</item>
        <item name="colorOnPrimary">@color/auf_primaer</item>
        <item name="colorPrimaryContainer">@color/primaer_leise</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorError">@color/gefahr</item>
        <item name="colorOnError">@color/auf_gefahr</item>
        <item name="colorSurface">@color/flaeche</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/flaeche_erhoben</item>
        <item name="colorOnSurfaceVariant">@color/text_leise</item>
        <item name="colorOutline">@color/umriss</item>
        <item name="colorOutlineVariant">@color/umriss_leise</item>
        <item name="android:colorBackground">@color/hintergrund</item>
        <item name="android:statusBarColor">@color/hintergrund</item>
        <item name="android:navigationBarColor">@color/flaeche</item>
    </style>
</resources>
